  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#836e42",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.documentation",
        "comment.block.documentation storage"
      ],
      "settings": {
        "foreground": "#836e42",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.from",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#916900",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords & storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#916900"
      }
    },
    {
      "name": "Operators & punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#836e42"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted.yaml",
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#4f6b3e"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression",
        "constant.character.format.placeholder",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#916900"
      }
    },
    {
      "name": "Escapes & regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#1d71b9"
      }
    },
    {
      "name": "Numbers & constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.language.boolean",
        "constant.language.python",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#1d71b9"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#190607",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "variable.function",
        "entity.name.function.call",
        "meta.method-call entity.name.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#190607"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#5e282c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.python",
        "storage.type.cs",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#5e282c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#5e282c"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#5e282c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self / this",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "variable.language.this",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#916900",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties & keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#5e282c"
      }
    },
    {
      "name": "Decorators & attributes",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute.cs",
        "entity.name.function.attribute",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#916900",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#916900"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#836e42",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
